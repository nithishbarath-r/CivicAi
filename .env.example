# ---------------------------------------------------------------------------
# CivicFix AI configuration
#
# Everything here is OPTIONAL. With no .env.local at all the app runs in local
# mode: sample data is seeded into your browser and reports you file persist
# there. Set DATABASE_URL to switch to real, shared, multi-user storage.
# ---------------------------------------------------------------------------

# Postgres connection string. Enables accounts, shared data and admin roles.
# DATABASE_URL=postgres://user:password@localhost:5432/civicfix

# Required in production once DATABASE_URL is set. Sign the session cookies.
# Generate with:  openssl rand -base64 32
# BETTER_AUTH_SECRET=

# Public URL of the deployment. Auto-detected on Vercel and in local dev.
# BETTER_AUTH_URL=https://civicfix.example.gov.in

# Passcode that elevates a signed-in account to admin. There is no default:
# without this, admin cannot be unlocked at all.
# ADMIN_PASSCODE=choose-something-long-and-private

# Optional connection pool size (default 10).
# DATABASE_POOL_MAX=10
